# Choose one provider for the answer-generation LLM. The retriever/embeddings
# run locally either way (TF-IDF, no download or key needed), so this only
# affects the final generated answer -- retrieval works with none of these set.
LLM_PROVIDER=groq          # "anthropic", "openai", "xai" (Grok), or "groq"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# xAI's Grok -- get a key at https://console.x.ai (API Keys page).
# NOTE: xAI (Grok) and Groq (below) are different companies -- easy to mix up.
XAI_API_KEY=
XAI_MODEL=grok-4.6

# Groq -- get a key at https://console.groq.com (API Keys page). Groq keys
# start with "gsk_". OpenAI-compatible endpoint, wired in via ChatOpenAI with
# a custom base_url -- see rag/llm.py. Default below is Groq's current
# general-purpose flagship per console.groq.com/docs/models.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
